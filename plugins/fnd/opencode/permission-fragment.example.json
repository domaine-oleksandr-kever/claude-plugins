{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "*--no-veri*": "deny",
      "git commit -n*": "deny",
      "git commit -an*": "deny",
      "git commit -na*": "deny",
      "git commit -nm*": "deny",
      "git commit -anm*": "deny",
      "*core.hooksPath*": "deny",
      "*core.hookspath*": "deny",
      "*HUSKY=0*": "deny",
      "rm *.husky*": "deny",
      "rm *.git/hooks*": "deny",
      "mv *.husky*": "deny",
      "mv *.git/hooks*": "deny",
      "chmod *.husky*": "deny",
      "chmod *.git/hooks*": "deny",
      "truncate *.husky*": "deny",
      "truncate *.git/hooks*": "deny",
      "ln *.husky*": "deny",
      "ln *.git/hooks*": "deny",
      "tee *.husky*": "deny",
      "tee *.git/hooks*": "deny",
      "git config --get core.hooksPath": "allow",
      "git config --get core.hookspath": "allow",
      "git config --get --global core.hooksPath": "allow",
      "chmod +x .husky/pre-commit": "allow",
      "chmod +x .husky/commit-msg": "allow",
      "chmod +x .husky/prepare-commit-msg": "allow",
      "chmod +x .husky/pre-push": "allow",
      "chmod +x .git/hooks/pre-commit": "allow",
      "chmod +x .git/hooks/commit-msg": "allow",
      "chmod +x .git/hooks/prepare-commit-msg": "allow",
      "chmod +x .git/hooks/pre-push": "allow",
      "git push --no-verify-signatures": "allow"
    }
  }
}
